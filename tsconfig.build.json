{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node16",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": false,
    "skipLibCheck": true,

    "outDir": "./dist",
    "rootDir": "./src",

    "resolveJsonModule": true
  },
  "include": ["src"]
}