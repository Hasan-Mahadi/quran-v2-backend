

NODE_ENV=development
PORT=3000
DATA_PATH=./src/data/quran-dataset
API_VERSION=v1
CACHE_TTL=3600
CACHE_MAX_KEYS=500
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
CORS_ORIGIN=*
MAX_JSON_SIZE=10mb
SEARCH_CASE_SENSITIVE=false
ENABLE_SEARCH_CACHE=true
DEFAULT_TRANSLATION_LANGUAGE=en
AUDIO_CACHE_TTL=86400
ENABLE_AUDIO_STREAMING=true